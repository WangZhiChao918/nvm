#!/usr/bin/env bash

# Fallback path: when `--lts=value` arrives as a single word (i.e. `=` is not
# a word-break character for this shell/config), completions must be returned
# with the `--lts=` prefix intact so the substituted word stays valid.
# Completion relies on bash arrays and `compgen`, so skip on other shells.
[ -n "${BASH_VERSION:-}" ] || exit 0

die () { echo "$@" ; exit 1 ; }

export NVM_DIR="$(cd ../../.. && pwd)"
: nvm.sh
\. ../../../nvm.sh || die "could not source nvm.sh"
\. ../../common.sh || die "could not source common.sh"

WORK_DIR="$(mktemp -d)" || die "could not create temp dir"
trap 'rm -rf "${WORK_DIR}"' EXIT
export NVM_DIR="${WORK_DIR}"
mkdir -p "${NVM_DIR}/alias/lts" || die "could not create lts alias dir"
: > "${NVM_DIR}/alias/lts/argon"
: > "${NVM_DIR}/alias/lts/boron"

\. ../../../bash_completion || die "could not source bash_completion"

in_reply () {
  local needle="$1" e
  for e in "${COMPREPLY[@]}"; do
    [ "${e}" = "${needle}" ] && return 0
  done
  return 1
}

# Single, unsplit word: `nvm use --lts=ar`
COMP_WORDS=(nvm use --lts=ar)
COMP_CWORD=2
COMPREPLY=()
__nvm

in_reply '--lts=argon' || die "expected '--lts=argon' in completions, got: ${COMPREPLY[*]}"
in_reply '--lts=boron' && die "did not expect '--lts=boron' for prefix 'ar', got: ${COMPREPLY[*]}"

exit 0
