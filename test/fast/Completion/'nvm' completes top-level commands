#!/usr/bin/env bash

# Regression: `nvm <TAB>` lists the top-level subcommands. Completion relies on
# bash arrays and `compgen`, so skip on other shells.
[ -n "${BASH_VERSION:-}" ] || exit 0

die () { echo "$@" ; exit 1 ; }

export NVM_DIR="$(cd ../../.. && pwd)"
: nvm.sh
\. ../../../nvm.sh || die "could not source nvm.sh"
\. ../../common.sh || die "could not source common.sh"

WORK_DIR="$(mktemp -d)" || die "could not create temp dir"
trap 'rm -rf "${WORK_DIR}"' EXIT
export NVM_DIR="${WORK_DIR}"
mkdir -p "${NVM_DIR}/alias" || die "could not create alias dir"

\. ../../../bash_completion || die "could not source bash_completion"

in_reply () {
  local needle="$1" e
  for e in "${COMPREPLY[@]}"; do
    [ "${e}" = "${needle}" ] && return 0
  done
  return 1
}

COMP_WORDS=(nvm '')
COMP_CWORD=1
COMPREPLY=()
__nvm

in_reply install || die "expected 'install' in completions, got: ${COMPREPLY[*]}"
in_reply use     || die "expected 'use' in completions, got: ${COMPREPLY[*]}"
in_reply alias   || die "expected 'alias' in completions, got: ${COMPREPLY[*]}"
in_reply ls      || die "expected 'ls' in completions, got: ${COMPREPLY[*]}"

exit 0
